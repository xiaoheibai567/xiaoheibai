# demo runs offline. api uses a Chat Completions-compatible model with tool calling.
LLM_MODE=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# hash is an offline lexical baseline, not a semantic embedding model.
EMBEDDING_MODE=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DATA_DIR=./data
API_TOKEN=
MAX_UPLOAD_MB=20
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
MIN_SCORE=0.1
REQUEST_TIMEOUT=30
MAX_TOOL_ROUNDS=5
MAX_TOOL_CALLS=8
# True seeds one fictional manual and an independent inventory database.
SEED_DEMO=true
# Only files inside this directory can be read by the model.
TOOL_FILES_DIR=./examples/files
SERIAL_MODE=mock
SERIAL_PORT=
SERIAL_BAUDRATE=115200
